{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Virtual Meetup: Godot Editor",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "node dev/dev.mjs editor"
    },
    {
      "name": "Virtual Meetup: MCP Server",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "node dev/mcp/launch-server.mjs",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Virtual Meetup: Headless MCP Editor",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "node dev/dev.mjs start",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Virtual Meetup: Project Map Request",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "node dev/map-project.mjs res:// --open --wait-for-workspace --stay-alive",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Virtual Meetup: Tests",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "node dev/dev.mjs game-headless res://tests/test_runner.tscn"
    }
  ],
  "compounds": [
    {
      "name": "Virtual Meetup: MCP Workspace",
      "configurations": ["Virtual Meetup: MCP Server", "Virtual Meetup: Headless MCP Editor"],
      "stopAll": true
    },
    {
      "name": "Virtual Meetup: Project Map",
      "configurations": ["Virtual Meetup: MCP Server", "Virtual Meetup: Headless MCP Editor", "Virtual Meetup: Project Map Request"],
      "stopAll": true
    }
  ]
}
